  "description": "Elegant WordPress table of contents plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "composer/installers": "~1.0"
  },
  "require-dev": {
