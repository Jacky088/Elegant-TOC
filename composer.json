{
  "name": "jacky088/elegant-toc",
  "description": "Elegant WordPress table of contents plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "composer/installers": "~1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "wp-coding-standards/wpcs": "^2.3"
  },
  "autoload": {
    "classmap": [
      "includes/"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs --standard=WordPress elegant-toc.php includes/",
    "phpcbf": "phpcbf --standard=WordPress elegant-toc.php includes/"
  }
}
